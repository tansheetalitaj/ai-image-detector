{
  "name": "tansheetalitaj/ai-image-detector",
  "description": "Experimental AI-image signal analysis application",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "ext-curl": "*",
    "ext-fileinfo": "*",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "squizlabs/php_codesniffer": "^3.13"
  },
  "autoload": {
    "psr-4": {
      "AiImageDetector\\": "src/"
    }
  },
  "scripts": {
    "lint:php": "phpcs",
    "test:unit": "phpunit --testsuite unit",
    "check": [
      "@lint:php",
      "@test:unit"
    ]
  },
  "config": {
    "sort-packages": true
  }
}
