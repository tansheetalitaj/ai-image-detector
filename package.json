{
  "name": "ai-image-detector",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint:js": "eslint public/assets/js tests/browser tests/unit/js playwright.config.js eslint.config.js",
    "format": "prettier --write \"public/assets/js/**/*.js\" \"tests/**/*.js\" \"*.js\" \"*.json\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"public/assets/js/**/*.js\" \"tests/**/*.js\" \"*.js\" \"*.json\" \".github/**/*.yml\"",
    "test:unit": "node --test \"tests/unit/js/*.test.js\"",
    "test:browser": "playwright test",
    "check": "npm run lint:js && npm run format:check && npm run test:unit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.8"
  }
}
