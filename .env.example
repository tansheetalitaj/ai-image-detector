# Copy this file to .env. Never commit .env or put real secrets in this example.

# Application
APP_ENV=local
APP_DEBUG=false
APP_URL=http://ai-image-detector.local
APP_API_PATH=/api/analyze.php

# Server-only Hugging Face credentials and model configuration
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_MODEL_ID=Organika/sdxl-detector
HUGGINGFACE_API_ENDPOINT=

# Model decision policy (raw scores, not calibrated probabilities)
MODEL_HUMAN_MAX_SCORE=0.35
MODEL_ARTIFICIAL_MIN_SCORE=0.65
MODEL_CONNECT_TIMEOUT_SECONDS=5
MODEL_REQUEST_TIMEOUT_SECONDS=30

# Upload validation
UPLOAD_MAX_FILE_BYTES=10485760
UPLOAD_MAX_WIDTH=8192
UPLOAD_MAX_HEIGHT=8192
UPLOAD_MAX_PIXELS=40000000

# CLI evaluation; leave blank to derive it from APP_URL + APP_API_PATH
EVALUATION_API_ENDPOINT=
